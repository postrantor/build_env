# ---
# date: 2026-08-21
# description: 工程宿主机环境变量与函数。只供 source, 不改系统文件。
# ---
#
# 约定:
#   调用前已设置 PROJECT_WORKDIR, 并已 source .env/project.bash。
#   加载 bashrc.bash / system.bash / common/setup/docker.bash;
#   不加载 robot.bash, 不跑 vcs / colcon / bashrc 模板。

if [[ -z "${PROJECT_WORKDIR:-}" ]]; then
  echo "error: PROJECT_WORKDIR is not set" >&2
  return 2
fi

# shellcheck disable=SC1091
source "${PROJECT_WORKDIR}/.env/bashrc.bash"
# shellcheck disable=SC1091
source "${PROJECT_WORKDIR}/.env/system.bash"
# robot.bash 会带上 colcon / vcs / 工程管理; hostrc.env 故意不加载。
# shellcheck disable=SC1091
source "$(cd "${PROJECT_WORKDIR}/.env" && cd ../setup && pwd)/docker.bash"
